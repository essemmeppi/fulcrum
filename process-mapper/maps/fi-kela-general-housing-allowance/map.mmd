  S_LANDLORD_MOVEOUT --> T_LANDLORD_NOTICE
  T_LANDLORD_NOTICE --> T_ASSESS_CHANGE
  T_ASSESS_CHANGE --> D_CHANGE_EFFECT
  D_CHANGE_EFFECT -->|"Revision trigger met (income +400/−200 €, costs ±50 €, dwelling/tenure, permanent household change, subtenant)"| T_REVISION_DATE
  D_CHANGE_EFFECT -->|"Termination ground (moved out without new dwelling, costs ceased, § 8 entitlement lost, single person absent > 3 months)"| T_TERMINATION_DATE
  D_CHANGE_EFFECT -->|"Good reason to assume no or reduced entitlement pending clarification"| T_SUSPEND
  D_CHANGE_EFFECT -->|"Change below thresholds or cost increase that would lower the allowance without income rise ≥ 400 €"| E_NO_CHANGE
  T_REVISION_DATE --> T_FETCH_INCOME
  T_SUSPEND --> T_REQUEST_INFO
  S_ANNUAL --> T_REVIEW_INSTR
  T_REVIEW_INSTR --> T_REVIEW_APP
  T_REVIEW_APP --> D_REVIEW_ON_TIME
  D_REVIEW_ON_TIME -->|"Review application received before the review date"| T_REGISTER
  D_REVIEW_ON_TIME -->|"Review information not provided in time"| T_TERMINATION_DATE
  S_NO_NEED --> T_TERMINATION_REQUEST
  T_TERMINATION_REQUEST --> T_TERMINATION_DATE
  T_TERMINATION_DATE --> T_DECIDE
  S_IMPULSE --> T_IMPULSE_TASK
  T_IMPULSE_TASK --> T_ROBOT_CHECK
  T_ROBOT_CHECK --> D_ROBOT_OUTCOME
  D_ROBOT_OUTCOME -->|"Entitlement lost or changed and case within automated processing rules"| T_AUTO_DECISION
  D_ROBOT_OUTCOME -->|"Case hits an exclusion rule – transferred to a caseworker"| T_TERMINATION_DATE
  D_ROBOT_OUTCOME -->|"Granted benefit has no effect on the allowance"| E_NO_CHANGE
  T_AUTO_DECISION --> T_NOTIFY
  S_UNPAID_RENT --> T_UNPAID_INFO
  T_UNPAID_INFO --> T_CONTACT_RECIPIENT
  T_CONTACT_RECIPIENT --> T_ASSESS_UNPAID
  T_ASSESS_UNPAID --> D_REDIRECT
  D_REDIRECT -->|"Pay landlord directly (§ 25(2) decision)"| T_DECIDE
  D_REDIRECT -->|"Circumstances do not justify redirection"| E_NO_CHANGE
  S_OVERPAYMENT --> T_ASSESS_RECOVERY
  T_ASSESS_RECOVERY --> D_RECOVER
  D_RECOVER -->|"Recovery required (no waiver grounds)"| T_RECOVERY_DECISION
  D_RECOVER -->|"Waiver reasonable and no fraud, or amount minor"| E_WAIVED
  T_RECOVERY_DECISION --> T_NOTIFY_RECOVERY
  T_NOTIFY_RECOVERY --> T_COLLECT
  T_COLLECT --> E_RECOVERED
  S_DISSATISFIED --> D_APPEALABLE
  D_APPEALABLE -->|"Decision is appealable"| T_APPEAL_SUBMIT
  D_APPEALABLE -->|"Interim decision or § 25(2) landlord-payment decision"| E_NOT_APPEALABLE
  T_APPEAL_SUBMIT --> T_SELF_RECT_EXAMINE
  T_SELF_RECT_EXAMINE --> D_ACCEPT_ALL
  D_ACCEPT_ALL -->|"All demands accepted"| T_RECTIFY_DECISION
  D_ACCEPT_ALL -->|"Not all demands accepted"| T_FORWARD_APPEAL
  T_RECTIFY_DECISION --> T_NOTIFY
  T_FORWARD_APPEAL --> T_SSAB_DECIDE
  T_SSAB_DECIDE --> D_FURTHER_APPEAL
  D_FURTHER_APPEAL -->|"Party appeals to Insurance Court"| T_IC_APPEAL
  D_FURTHER_APPEAL -->|"Board decision accepted and becomes final"| T_IMPLEMENT
  T_IC_APPEAL --> T_IC_DECIDE
  T_IC_DECIDE --> T_IMPLEMENT
  T_IMPLEMENT --> E_APPEAL_CLOSED
  S_NEW_EVIDENCE --> T_REEXAMINE
  T_REEXAMINE --> T_DECIDE
