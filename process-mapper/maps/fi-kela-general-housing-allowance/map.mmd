    T_SSAB_DECIDE["Social Security Appeal Board decides"]
  end
  subgraph insurance_court["Insurance Court (vakuutusoikeus)"]
    T_IC_DECIDE["Insurance Court decides"]
  end
  S_APPLY --> T_ESTIMATE
  T_ESTIMATE --> T_HOUSEHOLD_REP
  T_HOUSEHOLD_REP --> T_SUBMIT_APP
  T_SUBMIT_APP --> T_ATTACH
