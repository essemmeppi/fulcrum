  D_ELIGIBLE -->|"Any condition not met (income/asset limit exceeded, ineligible dwelling, student or pensioner exclusion, non-residence) – rejection or termination"| T_DECIDE
  T_CALC --> D_MIN_AMOUNT
  D_MIN_AMOUNT -->|"Amount ≥ 15 €/month – grant"| T_DECIDE
  D_MIN_AMOUNT -->|"Amount < 15 €/month – not paid"| T_DECIDE
  T_DECIDE --> T_NOTIFY
  T_NOTIFY --> D_PAYABLE
  D_PAYABLE -->|"Allowance granted or continues in payment"| T_STATE_NOTICE
  D_PAYABLE -->|"Rejected, below minimum or terminated"| E_NOT_PAYABLE
  T_STATE_NOTICE --> T_STATE_PAYS
  T_STATE_PAYS --> D_PAY_LANDLORD
  D_PAY_LANDLORD -->|"Recipient authorised landlord payment or § 25(2) decision in force"| T_PAY_LANDLORD
  D_PAY_LANDLORD -->|"Otherwise – pay to representative's account"| T_PAY_APPLICANT
  T_PAY_LANDLORD --> W_IN_PAYMENT
  T_PAY_APPLICANT --> W_IN_PAYMENT
  W_IN_PAYMENT -->|"Next month's payment cycle"| T_STATE_NOTICE
  S_CHANGE --> T_REPORT_CHANGE
