  subgraph kela_caseworker["Kela benefit caseworker"]
    T_COMPLETENESS["Check application completeness and documents"]
    D_COMPLETE{"Application complete?"}
    D_INFO_PROVIDED{"Information provided in reasonable time?"}
    T_RESIDENCE["Determine permanent residence in Finland"]
    T_HOUSEHOLD["Determine household composition"]
    T_INCOME["Determine monthly household income"]
    T_ELIG_CHECK["Assess eligibility conditions"]
    D_ELIGIBLE{"Eligibility conditions met?"}
    T_DECIDE["Make written decision"]
    T_ASSESS_CHANGE["Assess effect of reported change"]
    D_CHANGE_EFFECT{"Effect of change?"}
    T_REVISION_DATE["Determine revision effective date"]
    T_SUSPEND["Temporarily suspend or reduce payment"]
    T_TERMINATION_DATE["Determine termination effective date"]
    T_CONTACT_RECIPIENT["Contact recipient before redirecting payment"]
    T_ASSESS_UNPAID["Assess non-payment and recipient's circumstances"]
    D_REDIRECT{"Redirect payment to landlord?"}
