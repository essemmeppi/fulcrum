  T_REGISTER --> T_FETCH_INCOME
  T_FETCH_INCOME --> T_FETCH_LEASE
  T_FETCH_LEASE --> T_FETCH_TAX
  T_FETCH_TAX --> T_FETCH_OTHER
  T_FETCH_OTHER --> T_COMPLETENESS
  T_COMPLETENESS --> D_COMPLETE
  D_COMPLETE -->|"All information needed to decide is available"| T_RESIDENCE
  D_COMPLETE -->|"Application or attachments incomplete"| T_REQUEST_INFO
  T_REQUEST_INFO --> T_PROVIDE_INFO
  T_PROVIDE_INFO --> D_INFO_PROVIDED
  D_INFO_PROVIDED -->|"Requested information received"| T_COMPLETENESS
  D_INFO_PROVIDED -->|"Applicant refuses or fails to provide information within reasonable time – decide on available information"| T_RESIDENCE
  T_RESIDENCE --> T_HOUSEHOLD
  T_HOUSEHOLD --> T_INCOME
  T_INCOME --> T_ASSETS
  T_ASSETS --> T_COSTS
  T_COSTS --> T_ELIG_CHECK
  T_ELIG_CHECK --> D_ELIGIBLE
